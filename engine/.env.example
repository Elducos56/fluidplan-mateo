# fluidplan — keys for the illustration services. Copy this file to `.env` in this same folder
# (engine/, ignored by git) and fill in the keys you want; environment variables with the same
# name work too. Keys stay on the server: the page only knows "configured or not".
# Limit: at most 5 generations per service and per plan (see references/visuals.md).

OPENAI_API_KEY=
GEMINI_API_KEY=
LUDO_API_KEY=
MESHY_API_KEY=

# Optional: models and settings (defaults in parentheses).
# OPENAI_IMAGE_MODEL=        (gpt-image-2.5-flare)
# OPENAI_IMAGE_QUALITY=      (medium: low, medium, high, xhigh, max, auto)
# GEMINI_IMAGE_MODEL=        (gemini-3.1-flash-image)
# GEMINI_IMAGE_SIZE=         (1K: 512px, 1K, 2K, 4K)
# LUDO_IMAGE_TYPE=           (art: generic, art, sprite, icon, item-icon, ui_asset, portrait, splash…)
# LUDO_ART_STYLE=            (none: Hand-Painted, 16-Bit, Flat Design… see api.ludo.ai/api-docs)
# MESHY_IMAGE_MODEL=         (nano-banana: nano-banana-2, nano-banana-pro, gpt-image-2…)
